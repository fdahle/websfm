# JS / Vite
node_modules
dist
dist-ssr
*.local

# Rust / Cargo build output (each crate's compiled artifacts)
target/
crates/target/

# Test images / datasets — keep large binaries out of git
data/

# ONNX model weights — large (the SAM2 encoder alone is >GitHub's 100 MB limit)
# and downloaded on demand at runtime with user consent (see src/core/models/).
# Host these files at VITE_MODEL_BASE_URL (defaults to <site>/models/) instead of
# committing them.
public/models/*.onnx

# Example datasets for "Try an example": hosted like the models, fetched with
# `npm run fetch:examples` (see src/core/examples.js).
public/examples/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Environment files (build settings such as VITE_MODEL_BASE_URL; may hold secrets)
.env
.env.*
!.env.example

# Logs and coverage
*.log
coverage/

# Local Claude Code state (machine-specific permissions, worktrees, task locks)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Note: src/wasm/** (the generated WASM bindings) is intentionally NOT ignored,
# so the app runs on a fresh clone without needing the Rust toolchain.


# Browser test artifacts
playwright-report/
test-results/
bench-out/
# Bench configs name datasets by local path (only meaningful on the machine that has them).
scripts/bench/configs/

# Internal development docs, kept locally and never published: everything under
# dev/ (plan, done log, verification register, planning specs) and personal Claude
# Code notes. CLAUDE.md itself is public: it imports AGENTS.md and CONTRIBUTING.md.
/dev/
CLAUDE.local.md

# Python (scripts/bench, scripts/examples)
__pycache__/
.venv/

# Claude Code's local state (worktrees, personal settings)
.claude/worktrees/
.claude/settings.local.json
