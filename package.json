{
  "name": "websfm",
  "private": true,
  "version": "0.9.0",
  "description": "Structure-from-Motion and photogrammetry, entirely in the browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdahle/websfm.git"
  },
  "homepage": "https://github.com/fdahle/websfm#readme",
  "bugs": {
    "url": "https://github.com/fdahle/websfm/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "npm run build && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "release": "node scripts/release.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "fetch:examples": "node scripts/fetch-examples.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/check-io-types.mjs && vue-tsc --noEmit -p tsconfig.vue.json && node scripts/check-vue-bindings.mjs && npm run lint",
    "build:wasm": "wasm-pack build crates/sift --target web --out-dir ../../src/wasm/detection && wasm-pack build crates/matching --target web --out-dir ../../src/wasm/matching && wasm-pack build crates/reconstruction --target web --out-dir ../../src/wasm/reconstruction && node scripts/build-wasm-mt.mjs && wasm-pack build crates/mesh --target web --out-dir ../../src/wasm/mesh && wasm-pack build crates/imagecodec --target web --out-dir ../../src/wasm/imagecodec && wasm-pack build crates/lazcodec --target web --out-dir ../../src/wasm/lazcodec && node scripts/build-wasm64.mjs && rm -f src/wasm/*/.gitignore && node scripts/licenses/cargo.mjs && node scripts/wasm-stamp.mjs --write",
    "test:browser": "playwright test --project=chromium",
    "test:browser:firefox": "playwright test --project=firefox",
    "test:browser:webkit": "playwright test --project=webkit",
    "test:wasm": "node scripts/check-laz-wasm.mjs",
    "check:interop": "node scripts/interop/check.mjs bench-out/interop",
    "check:wasm": "node scripts/wasm-stamp.mjs",
    "licenses:rust": "node scripts/licenses/cargo.mjs",
    "lint": "eslint src scripts tests *.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "docs:features": "node scripts/docs-features.mjs",
    "docs:readme": "node scripts/docs-readme.mjs",
    "screenshots": "node scripts/screenshots/shoot.mjs",
    "test:mutation": "stryker run",
    "gate": "node scripts/bench/suites/gate.mjs",
    "bench": "node scripts/bench/cli.mjs",
    "gate:sfm": "WEBSFM_SFM_GATE=1 vitest run src/core/sfm/sfmGate.test.js",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "delaunator": "5.1.0",
    "epsg-index": "^2.0.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "intl-messageformat": "^12.2.0",
    "katex": "0.18.10",
    "marked": "^18.2.1",
    "marked-katex-extension": "^5.1.10",
    "ol": "^10.11.0",
    "onnxruntime-web": "^1.31.1",
    "pinia": "^3.0.4",
    "proj4": "^2.23.0",
    "three": "^0.187.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "^11.0.1",
      "qs": "^6.16.1"
    },
    "workbox-build": {
      "glob": "^14.0.2"
    }
  }
}
