// The file parsers and writers in src/core/io that type-check clean in loose mode (JS
// inference, no implicit-any errors). scripts/check-io-types.mjs runs it and fails on an
// error in a listed file; files they import are checked but not reported. A parser joins
// the list once it passes. Every parser and writer in src/core/io is listed (2026-11-13).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [],
  "files": [
