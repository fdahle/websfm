# Auto detect text files and perform LF normalization
* text=auto

# Binary artifacts: never diff or normalise line endings.
*.wasm binary
*.onnx binary
*.glb  binary
*.laz  binary
*.tif  binary
*.tiff binary
*.png  binary
*.jpg  binary
*.jpeg binary

# Generated by npm run build:wasm (scripts/licenses/cargo.mjs): one long line of JSON.
src/wasm/third-party.json -diff linguist-generated=true
